{
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "./dist",
  "redirects": [
    { "source": "/wiki", "destination": "/wiki/", "statusCode": 301 },
    { "source": "/wiki/requirements", "destination": "/wiki/requirements/", "statusCode": 301 },
    { "source": "/wiki/ai-api", "destination": "/wiki/ai-api/", "statusCode": 301 },
    { "source": "/wiki/ops", "destination": "/wiki/ops/", "statusCode": 301 },
    { "source": "/wiki/dev", "destination": "/wiki/dev/", "statusCode": 301 },
    { "source": "/wiki/timeline", "destination": "/wiki/timeline/", "statusCode": 301 },
    { "source": "/wiki/todo", "destination": "/wiki/todo/", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/*", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/assets/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/wiki/*", "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "schedules": [
    { "name": "daily-cleanup", "cron": "0 4 * * *", "path": "/api/cron/cleanup", "method": "POST", "timezone": "Asia/Shanghai" }
  ]
}
